<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge" Width="1320" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#ECE5D6"
        FontFamily="Segoe UI" FontSize="14" Foreground="#3F463E"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Design: WinForge-UI.html (soft workspace concept). Colours and shapes follow its CSS
       variables: paper #FFF5E7, ink #3F463E, muted #7B8074, sage #BFD2BD, green #497B66. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Paper" Color="#FFF5E7"/>
    <SolidColorBrush x:Key="Ink" Color="#3F463E"/>
    <SolidColorBrush x:Key="Muted" Color="#7B8074"/>
    <SolidColorBrush x:Key="Line" Color="#E7DECA"/>
    <SolidColorBrush x:Key="Green" Color="#497B66"/>
    <SolidColorBrush x:Key="LinkGreen" Color="#537C63"/>
    <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7EAA8C" Offset="0"/><GradientStop Color="#588D76" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFF9EC" Offset="0"/><GradientStop Color="#EEE4CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFF6E6" Offset="0"/><GradientStop Color="#F8EDDB" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Soft" Color="#A79572" Opacity="0.22" BlurRadius="16" ShadowDepth="6" Direction="315"/>

    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="H3" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#6C7F69"/></Style>
    <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="20"/>
      <Setter Property="Background" Value="{StaticResource PanelFill}"/>
      <Setter Property="BorderBrush" Value="#E6FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect" Value="{StaticResource Soft}"/><Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="Tag" TargetType="Border">
      <Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="8,3"/>
      <Setter Property="Background" Value="#E1E9D6"/><Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="14" Background="{StaticResource PrimaryFill}" BorderBrush="#80FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#2F5546"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="#625F4C"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="14" Background="{StaticResource SecondaryFill}" BorderBrush="#C8E7DECA" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F3E9D4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#497B66"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="14" Background="#B9644B" BorderBrush="#80FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#5E2A1C"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource LinkGreen}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#537C63"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#497B66"/><Setter TargetName="b" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar navigation: one RadioButton per page. -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="GroupName" Value="nav"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="16" Padding="15,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#48FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SecondaryFill}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#99FFFFFF"/>
                <Setter TargetName="b" Property="Effect" Value="{StaticResource Soft}"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#497B66"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The prototype's pill toggle, as a CheckBox. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="track" Width="38" Height="22" CornerRadius="11" Background="#DAD8C9" Padding="3" BorderBrush="Transparent" BorderThickness="1">
                <Ellipse x:Name="thumb" Width="15" Height="15" Fill="#FFF9EC" HorizontalAlignment="Left"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#78A283"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#2F5546"/><Setter TargetName="track" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Width" Value="270"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="20" Background="#F6EDDB" BorderBrush="White" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#497B66"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#FFF9EF"/><Setter Property="AlternatingRowBackground" Value="#F8EEDC"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#E0E9D7"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="MinWidth" Value="150"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
  </Window.Resources>

  <Grid>
    <Grid x:Name="Root">
      <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" BorderBrush="#77FFFFFF" BorderThickness="0,0,2,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D3DFCC" Offset="0"/><GradientStop Color="#BFCFBD" Offset="1"/></LinearGradientBrush>
        </Border.Background>
        <DockPanel Margin="18,28,18,22" LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
            <Border Width="43" Height="43" CornerRadius="15" Background="{StaticResource PrimaryFill}" Effect="{StaticResource Soft}">
              <TextBlock Text="&#x2726;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="#FFF7E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="WinForge" FontSize="24" FontWeight="ExtraBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" CornerRadius="20" Padding="16" Background="#35FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1" Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="THIS PC"/>
              <TextBlock x:Name="MachineTitle" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap" Text="Reading system..."/>
              <TextBlock x:Name="MachineSub" FontSize="12" Foreground="#66755F" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel DockPanel.Dock="Top" x:Name="NavPanel">
            <RadioButton Style="{StaticResource Nav}" x:Name="NavDashboard" Tag="Dashboard" IsChecked="True" AutomationProperties.Name="Dashboard"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Dashboard"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavTweaks" Tag="Tweaks" AutomationProperties.Name="System tweaks"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Width="28" VerticalAlignment="Center"/><TextBlock Text="System tweaks"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavApps" Tag="Apps" AutomationProperties.Name="Applications"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Applications"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavProfiles" Tag="Profiles" AutomationProperties.Name="Profiles"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Profiles"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavSecurity" Tag="Security" AutomationProperties.Name="Security audit"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Security audit"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavMonitoring" Tag="Monitoring" AutomationProperties.Name="Monitoring"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Monitoring"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavHistory" Tag="History" AutomationProperties.Name="History and rollback"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="28" VerticalAlignment="Center"/><TextBlock Text="History &amp; rollback"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource Nav}" x:Name="NavSettings" Tag="Settings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="28" VerticalAlignment="Center"/><TextBlock Text="Settings"/></StackPanel></RadioButton>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" CornerRadius="20" Padding="17" Background="#80FFF5DF">
            <StackPanel>
              <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="Thoughtful changes. Not blind tweaks."/>
              <TextBlock FontSize="12" Foreground="#6B7565" TextWrapping="Wrap" Margin="0,6,0,0" Text="Preview first. Authorize explicitly. Keep a record."/>
              <TextBlock x:Name="VersionText" FontSize="10" Foreground="#6B7565" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Main column -->
      <DockPanel Grid.Column="1" Background="{StaticResource Paper}">
        <Grid DockPanel.Dock="Top" Margin="34,28,34,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="Dashboard"/>
            <TextBlock x:Name="PageSub" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="A calmer way to configure Windows."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid>
              <TextBox x:Name="SearchBox" Style="{StaticResource Search}" AutomationProperties.Name="Search tweaks"/>
              <TextBlock x:Name="SearchHint" Text="Search tweaks..." Foreground="#9A9784" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Border x:Name="ModePill" CornerRadius="14" Padding="11,6" Background="#E0E9D7" BorderBrush="#A0FFFFFF" BorderThickness="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="ModeText" FontSize="11" Text="Standard mode"/>
            </Border>
          </StackPanel>
        </Grid>

        <Border x:Name="ElevationBanner" DockPanel.Dock="Top" Margin="34,0,34,10" CornerRadius="13" Padding="12" Background="#EFE0C4" Visibility="Collapsed">
          <TextBlock FontSize="12" TextWrapping="Wrap" Text="WinForge is not running as administrator. You can browse and preview everything, but Apply, Undo and installs need administrator rights: close this window and start WinForge.bat."/>
        </Border>

        <!-- Footer action bar -->
        <Border DockPanel.Dock="Bottom" Margin="34,6,34,22" CornerRadius="21" Padding="20,15" Effect="{StaticResource Soft}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D6E1CD" Offset="0"/><GradientStop Color="#BCD2C0" Offset="1"/></LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource H3}" Text="Review first. Change with confidence."/>
              <TextBlock x:Name="SelectionLine" FontSize="12" Foreground="#687D65" Margin="0,4,0,0" TextWrapping="Wrap" Text="Select tweaks to build a change plan."/>
              <ProgressBar x:Name="RunProgress" Height="6" Margin="0,8,20,0" Visibility="Collapsed" Foreground="#497B66" Background="#E9F0E3" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CancelRunBtn" Style="{StaticResource Secondary}" Content="Cancel run" Visibility="Collapsed"/>
              <Button x:Name="ClearSelectionBtn" Style="{StaticResource Secondary}" Content="Clear"/>
              <Button x:Name="ReviewBtn" Style="{StaticResource Primary}" Content="Review selection &#x2192;" Margin="0"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="34,6,34,0">
          <Grid>
            <!-- Dashboard -->
            <StackPanel x:Name="PageDashboard">
              <Border CornerRadius="26" Padding="30,26" Effect="{StaticResource Soft}" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,0,6">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F9D8BB" Offset="0"/><GradientStop Color="#F8DFC8" Offset="0.6"/><GradientStop Color="#F3CFAD" Offset="1"/></LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Eyebrow}" Foreground="#8A6E52" Text="YOUR SYSTEM. YOUR RULES."/>
                    <TextBlock FontSize="29" FontWeight="Bold" Margin="0,8,0,10" TextWrapping="Wrap" Text="Make Windows feel like yours."/>
                    <TextBlock Foreground="#7C6D55" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,18" Text="A little less clutter. A little more control. Every change is previewed against your real system first, and every run can be undone."/>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ExploreBtn" Style="{StaticResource Primary}" Content="Explore tweaks &#x2192;"/>
                      <Button x:Name="HeroPreviewBtn" Style="{StaticResource Secondary}" Content="Preview selection"/>
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Column="1" Width="210" Height="155" Margin="20,0,0,0">
                    <Border Width="150" Height="150" CornerRadius="40" HorizontalAlignment="Right" Margin="0,0,22,0" RenderTransformOrigin="0.5,0.5">
                      <Border.RenderTransform><RotateTransform Angle="-12"/></Border.RenderTransform>
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BED4B4" Offset="0"/><GradientStop Color="#739E7E" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Border.Effect><DropShadowEffect Color="#936A47" Opacity="0.25" BlurRadius="20" ShadowDepth="12"/></Border.Effect>
                      <TextBlock Text="&#x2726;" FontFamily="Segoe UI Symbol" FontSize="72" Foreground="#FFF4DC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="18" Padding="16,10" Background="#FFF0D6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Effect="{StaticResource Soft}" RenderTransformOrigin="0.5,0.5">
                      <Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform>
                      <TextBlock FontSize="12" Text="Preview first &#xB7; Undo anytime"/>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                <Ellipse Width="7" Height="7" Fill="#9A9772" VerticalAlignment="Center"/>
                <TextBlock x:Name="NoticeText" FontSize="11" Foreground="#857C68" Margin="8,0,0,0" Text="Reading catalog and system..."/>
              </StackPanel>

              <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Background="#E2E8CF" Margin="0,0,9,14"><StackPanel>
                  <Border Width="39" Height="39" CornerRadius="13" Background="{StaticResource PrimaryFill}" HorizontalAlignment="Left"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F8;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock FontSize="12" Margin="0,14,0,0" Text="System compatibility"/>
                  <TextBlock x:Name="StatCompat" FontSize="24" FontWeight="Bold" Margin="0,4" Text="Checking..."/>
                  <TextBlock x:Name="StatCompatHint" FontSize="11" Foreground="#787963" TextWrapping="Wrap" Text="Catalog checked against this PC"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#F7D8C6" Margin="9,0,9,14"><StackPanel>
                  <Border Width="39" Height="39" CornerRadius="13" Background="#D78366" HorizontalAlignment="Left"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock FontSize="12" Margin="0,14,0,0" Text="Selected tweaks"/>
                  <TextBlock x:Name="StatSelected" FontSize="24" FontWeight="Bold" Margin="0,4" Text="0"/>
                  <TextBlock FontSize="11" Foreground="#787963" TextWrapping="Wrap" Text="Nothing changes until you confirm"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#F6E5B8" Margin="9,0,9,14"><StackPanel>
                  <Border Width="39" Height="39" CornerRadius="13" Background="#CDA24C" HorizontalAlignment="Left"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock FontSize="12" Margin="0,14,0,0" Text="Security baseline"/>
                  <TextBlock x:Name="StatSecurity" FontSize="24" FontWeight="Bold" Margin="0,4" Text="Checking..."/>
                  <TextBlock x:Name="StatSecurityHint" FontSize="11" Foreground="#787963" TextWrapping="Wrap" Text="Read from Windows; no invented score"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#DCE5E3" Margin="9,0,0,14"><StackPanel>
                  <Border Width="39" Height="39" CornerRadius="13" Background="#79949C" HorizontalAlignment="Left"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock FontSize="12" Margin="0,14,0,0" Text="Rollback available"/>
                  <TextBlock x:Name="StatRollback" FontSize="24" FontWeight="Bold" Margin="0,4" Text="-"/>
                  <TextBlock x:Name="StatRollbackHint" FontSize="11" Foreground="#787963" TextWrapping="Wrap" Text="Recorded runs that can be undone"/>
                </StackPanel></Border>
              </UniformGrid>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,12"><Border DockPanel.Dock="Right" Style="{StaticResource Tag}"><TextBlock FontSize="10" Foreground="#58734E" Text="Minimal profile"/></Border><TextBlock Style="{StaticResource H2}" Text="Start with the essentials"/></DockPanel>
                    <StackPanel x:Name="EssentialsList"/>
                  </StackPanel></Border>
                  <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Your profiles" Margin="0,0,0,12"/>
                    <StackPanel x:Name="DashProfilesList"/>
                  </StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,12"><Border DockPanel.Dock="Right" Style="{StaticResource Tag}"><TextBlock FontSize="10" Foreground="#58734E" Text="Read from Windows"/></Border><TextBlock Style="{StaticResource H2}" Text="System insights"/></DockPanel>
                    <StackPanel x:Name="InsightsList"/>
                  </StackPanel></Border>
                  <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,12"><Button x:Name="DashHistoryLink" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="View history &#x2192;"/><TextBlock Style="{StaticResource H2}" Text="Recent activity"/></DockPanel>
                    <StackPanel x:Name="RecentList"/>
                  </StackPanel></Border>
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- System tweaks -->
            <StackPanel x:Name="PageTweaks" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="16,12"><WrapPanel>
                <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <ComboBox x:Name="FilterCategory" AutomationProperties.Name="Filter by category"/>
                <TextBlock Text="Risk" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <ComboBox x:Name="FilterRisk" AutomationProperties.Name="Filter by risk"/>
                <CheckBox x:Name="FilterNotApplied" Style="{StaticResource Switch}" Content="Not applied only" Margin="6,0,18,0" FontSize="12"/>
                <CheckBox x:Name="FilterSelected" Style="{StaticResource Switch}" Content="Selected only" Margin="0,0,18,0" FontSize="12"/>
                <Button x:Name="SelectShownBtn" Style="{StaticResource Link}" Content="Select all shown (skips Danger)" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <Button x:Name="RefreshStatusBtn" Style="{StaticResource Link}" Content="Re-check status" VerticalAlignment="Center"/>
              </WrapPanel></Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Grid.Column="0"><StackPanel>
                  <TextBlock x:Name="TweakCountText" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
                  <StackPanel x:Name="TweakList"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Grid.Column="2" VerticalAlignment="Top"><StackPanel>
                  <TextBlock x:Name="DetailTitle" Style="{StaticResource H2}" TextWrapping="Wrap" Text="Select a tweak"/>
                  <WrapPanel x:Name="DetailTags" Margin="-6,10,0,0"/>
                  <TextBlock x:Name="DetailDesc" Style="{StaticResource Sub}" FontSize="13" Margin="0,12,0,0" Text="Click a tweak to see what it changes, the current value on this PC, and how it can be undone."/>
                  <TextBlock Style="{StaticResource Eyebrow}" Text="CURRENT &#x2192; NEW (ON THIS PC)" Margin="0,16,0,6"/>
                  <Border CornerRadius="12" Background="#F3E8D2" Padding="12"><TextBlock x:Name="DetailPlan" Style="{StaticResource Mono}" Text="-"/></Border>
                  <TextBlock x:Name="DetailSource" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                </StackPanel></Border>
              </Grid>
            </StackPanel>

            <!-- Applications -->
            <StackPanel x:Name="PageApps" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Package managers"/>
                <TextBlock x:Name="ProvidersText" Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Checking winget and Chocolatey..."/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="Installs use winget pinned to its own source with exact IDs. Chocolatey is used only if it is already installed (or as a fallback you switch on). WinForge never installs Chocolatey for you, and takes a System Restore point before real installs when it can."/>
                <CheckBox x:Name="ChocoFallback" Style="{StaticResource Switch}" Content="Fall back to Chocolatey when winget fails" Margin="0,12,0,0" FontSize="12"/>
              </StackPanel></Border>
              <StackPanel x:Name="BundlesList"/>
            </StackPanel>

            <!-- Profiles -->
            <StackPanel x:Name="PageProfiles" Visibility="Collapsed">
              <TextBlock Style="{StaticResource Sub}" Margin="4,0,0,12" Text="Profiles are lists of catalog tweaks. None of them contains a Danger tweak; those need Expert mode and are always chosen one at a time."/>
              <StackPanel x:Name="ProfilesList"/>
            </StackPanel>

            <!-- Security -->
            <StackPanel x:Name="PageSecurity" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel>
                <DockPanel Margin="0,0,0,12"><Button x:Name="SecurityRefreshBtn" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Refresh"/><TextBlock Style="{StaticResource H2}" Text="Security posture (read-only)"/></DockPanel>
                <StackPanel x:Name="SecurityList"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0" Text="'Unavailable' means Windows did not answer (often because WinForge is not elevated). It never means the protection is off."/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Diagnostic data, honestly"/>
                <TextBlock x:Name="PrivacyNote" Style="{StaticResource Sub}" FontSize="13" Margin="0,10,0,0"/>
              </StackPanel></Border>
            </StackPanel>

            <!-- Monitoring -->
            <StackPanel x:Name="PageMonitoring" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel>
                <WrapPanel Margin="0,0,0,12">
                  <Button x:Name="MonitorRefreshBtn" Style="{StaticResource Primary}" Content="Take snapshot"/>
                  <Button x:Name="MonitorExportBtn" Style="{StaticResource Secondary}" Content="Save snapshot..."/>
                  <CheckBox x:Name="MonitorResolve" Style="{StaticResource Switch}" Content="Look up host names (sends reverse DNS queries)" Margin="8,0,0,0" FontSize="12"/>
                </WrapPanel>
                <TextBlock x:Name="MonitorStatus" Style="{StaticResource Sub}" Margin="0,0,0,10" Text="Established TCP connections, read from Windows when you take a snapshot. This is not packet capture: it shows who a process talks to, not what it sends."/>
                <DataGrid x:Name="MonitorGrid" AutoGenerateColumns="True" MaxHeight="520" MinHeight="120"/>
              </StackPanel></Border>
            </StackPanel>

            <!-- History -->
            <StackPanel x:Name="PageHistory" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="HistoryRefreshBtn" Style="{StaticResource Link}" Content="Refresh" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Button x:Name="UndoRunBtn" Style="{StaticResource Primary}" Content="Undo selected run..." Margin="0" IsEnabled="False"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="Tweak runs" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="RunsGrid" AutoGenerateColumns="True" MaxHeight="300" MinHeight="90"/>
                <TextBlock Style="{StaticResource Eyebrow}" Text="SELECTED RUN" Margin="0,14,0,6"/>
                <Border CornerRadius="12" Background="#F3E8D2" Padding="12"><TextBlock x:Name="RunDetail" Style="{StaticResource Mono}" Text="Select a run to see each tweak, its status and whether it was undone."/></Border>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="App installs" Margin="0,0,0,12"/>
                <DataGrid x:Name="InstallsGrid" AutoGenerateColumns="True" MaxHeight="240" MinHeight="70"/>
              </StackPanel></Border>
            </StackPanel>

            <!-- Settings -->
            <StackPanel x:Name="PageSettings" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Expert mode"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,8,0,12" Text="Shows Danger tweaks (they weaken security or break features such as printing). They are never part of a profile, are never picked by 'Select all', and each one must be confirmed by typing its ID. The engine enforces this on its own; hiding them here is only a convenience."/>
                <CheckBox x:Name="ExpertToggle" Style="{StaticResource Switch}" Content="Show Danger tweaks"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="About this installation"/>
                <TextBlock x:Name="AboutText" Style="{StaticResource Mono}" Margin="0,10,0,12"/>
                <Button x:Name="ValidateBtn" Style="{StaticResource Secondary}" Content="Validate catalog" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ValidateResult" Style="{StaticResource Mono}" Margin="0,10,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Dialog overlay -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="#7728392D">
      <Border x:Name="DialogBox" Width="680" MaxHeight="760" CornerRadius="25" Padding="26" Background="#FFF5E6" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect><DropShadowEffect Color="#24372D" Opacity="0.35" BlurRadius="60" ShadowDepth="16"/></Border.Effect>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="DialogClose" DockPanel.Dock="Right" Style="{StaticResource Link}" FontSize="20" Content="&#x2715;" AutomationProperties.Name="Close dialog"/>
            <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel x:Name="ExpertConfirmPanel" Visibility="Collapsed" Margin="0,0,0,12">
              <TextBlock x:Name="ExpertConfirmLabel" FontSize="12" TextWrapping="Wrap" Foreground="#8A4B3A" Margin="0,0,0,6"/>
              <TextBox x:Name="ExpertConfirmBox" Padding="8,6" FontFamily="Consolas" AutomationProperties.Name="Type the Danger tweak ID to confirm"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="DialogSecondary" Style="{StaticResource Secondary}" Content="Cancel"/>
              <Button x:Name="DialogPrimary" Style="{StaticResource Primary}" Content="OK" Margin="0"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DialogBody"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
